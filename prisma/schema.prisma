generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
}

model User {
  name           String    @id
  hashedPassword String
  departmentName String
  active         Boolean   @default(true)
  role           UserRole  @default(USER)
  createdAt      DateTime  @default(now())
  lastLogin      DateTime?

  department          Department           @relation("BelongsTo", fields: [departmentName], references: [name])
  managedDepartment   Department?          @relation("Manages")
  createdTypes        TransactionType[]
  createdTransactions Transaction[]
  uploadedDocuments   Document[]
  sentForwards        TransactionForward[] @relation("SentForwards")
  receivedForwards    TransactionForward[] @relation("ReceivedForwards")
}

enum UserRole {
  ADMIN
  USER
}

model Department {
  name        String @id
  managerName String @unique

  manager User   @relation("Manages", fields: [managerName], references: [name])
  members User[] @relation("BelongsTo")
}

model Document {
  id           Int      @id @default(autoincrement())
  title        String
  content      Bytes
  uploaderName String
  uploadedAt   DateTime @default(now())

  uploader     User          @relation(fields: [uploaderName], references: [name])
  transactions Transaction[] @relation("AttachedTo")
}

model Transaction {
  id          Int                 @id @default(autoincrement())
  title       String
  description String
  typeName    String
  fulfilled   Boolean             @default(false)
  priority    TransactionPriority @default(LOW)
  creatorName String
  createdAt   DateTime            @default(now())

  type      TransactionType      @relation(fields: [typeName], references: [name])
  creator   User                 @relation(fields: [creatorName], references: [name])
  documents Document[]           @relation("AttachedTo")
  forwards  TransactionForward[]
}

enum TransactionPriority {
  HIGH
  MEDIUM
  LOW
}

model TransactionType {
  name        String @id
  creatorName String

  creator      User          @relation(fields: [creatorName], references: [name])
  transactions Transaction[]
}

model TransactionForward {
  id              Int                      @id @default(autoincrement())
  status          TransactionForwardStatus @default(WAITING)
  senderComment   String?
  receiverComment String?
  senderName      String
  receiverName    String
  seen            Boolean                  @default(false)
  forwardedAt     DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  transactionId   Int

  transaction Transaction @relation(fields: [transactionId], references: [id])
  sender      User        @relation("SentForwards", fields: [senderName], references: [name])
  receiver    User        @relation("ReceivedForwards", fields: [receiverName], references: [name])
}

enum TransactionForwardStatus {
  WAITING
  NEEDS_EDITING
  REJECTED
  APPROVED
}
