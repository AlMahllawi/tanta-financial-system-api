generator client {
  provider        = "prisma-client"
  output          = "./generated"
  previewFeatures = ["views"]
}

datasource db {
  provider = "postgresql"
}

model Department {
  name      String @id
  managerId Int?   @unique

  manager User?  @relation("Manages", fields: [managerId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_department_manager")
  members User[] @relation("BelongsTo")
}

enum UserRole {
  ADMIN
  USER
}

model User {
  id             Int       @id @default(autoincrement())
  name           String    @unique(map: "uq_user_name")
  hashedPassword String
  departmentName String
  active         Boolean   @default(true)
  role           UserRole  @default(USER)
  createdAt      DateTime  @default(now()) @db.Timestamptz
  lastLogin      DateTime? @db.Timestamptz

  department          Department            @relation("BelongsTo", fields: [departmentName], references: [name], onDelete: Restrict, onUpdate: Cascade, map: "fk_user_department")
  managedDepartment   Department?           @relation("Manages")
  createdTypes        TransactionType[]
  createdTransactions Transaction[]
  uploadedDocuments   Document[]
  attachedDocuments   TransactionDocument[]
  sentForwards        TransactionForward[]  @relation("SentForwards")
  receivedForwards    TransactionForward[]  @relation("ReceivedForwards")
}

model Document {
  id         Int      @id @default(autoincrement())
  title      String
  content    Bytes
  uploaderId Int
  uploadedAt DateTime @default(now()) @db.Timestamptz

  uploader     User                  @relation(fields: [uploaderId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  transactions TransactionDocument[]
}

enum TransactionPriority {
  HIGH
  MEDIUM
  LOW
}

model Transaction {
  id          Int                 @id @default(autoincrement())
  title       String
  description String
  typeName    String
  fulfilled   Boolean             @default(false)
  priority    TransactionPriority @default(LOW)
  creatorId   Int
  createdAt   DateTime            @default(now()) @db.Timestamptz

  type          TransactionType           @relation(fields: [typeName], references: [name], onDelete: Restrict, onUpdate: Cascade)
  creator       User                      @relation(fields: [creatorId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  documents     TransactionDocument[]
  forwards      TransactionForward[]
  latestForward TransactionLatestForward?
}

// TODO: This view is manually created in the migration since `view` is a prisma preview feature atm
view TransactionLatestForward {
  id            Int                      @unique
  status        TransactionForwardStatus
  senderId      Int
  receiverId    Int
  transactionId Int

  transaction Transaction @relation(fields: [transactionId], references: [id])

  // TODO: ORDER BY "transactionId", "id" DESC (not available in prisma atm)
  @@unique([transactionId])
}

model TransactionDocument {
  transactionId Int
  documentId    Int
  attachedBy    Int
  attachedAt    DateTime @default(now()) @db.Timestamptz

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  document    Document    @relation(fields: [documentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  attacher    User        @relation(fields: [attachedBy], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@id([transactionId, documentId], map: "pk_transaction_document")
}

model TransactionType {
  name      String @id
  creatorId Int

  creator      User          @relation(fields: [creatorId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  transactions Transaction[]
}

enum TransactionForwardStatus {
  WAITING
  NEEDS_EDITING
  REJECTED
  APPROVED
}

model TransactionForward {
  id              Int                      @id @default(autoincrement())
  status          TransactionForwardStatus @default(WAITING)
  senderComment   String?
  receiverComment String?
  senderId        Int
  receiverId      Int
  senderSeen      Boolean                  @default(true)
  receiverSeen    Boolean                  @default(false)
  forwardedAt     DateTime                 @default(now()) @db.Timestamptz
  updatedAt       DateTime                 @updatedAt @db.Timestamptz
  transactionId   Int

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  sender      User        @relation("SentForwards", fields: [senderId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  receiver    User        @relation("ReceivedForwards", fields: [receiverId], references: [id], onDelete: Restrict, onUpdate: Cascade)
}
