generator client {
  provider        = "prisma-client"
  output          = "./generated"
  previewFeatures = ["views"]
}

datasource db {
  provider = "postgresql"
}

model Department {
  name      String @id
  managerId Int?   @unique(map: "uq_department_manager")

  manager User?  @relation("Manages", fields: [managerId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_department_manager")
  members User[] @relation("BelongsTo")
}

enum UserRole {
  ADMIN
  USER
  ACCOUNTANT
}

enum UserPresence {
  ONLINE
  OFFLINE
}

model User {
  id             Int          @id @default(autoincrement())
  name           String       @unique(map: "uq_user_name")
  hashedPassword String
  departmentName String
  active         Boolean      @default(true)
  role           UserRole     @default(USER)
  presence       UserPresence @default(OFFLINE)
  createdAt      DateTime     @default(now()) @db.Timestamptz
  lastLogin      DateTime?    @db.Timestamptz

  department          Department            @relation("BelongsTo", fields: [departmentName], references: [name], onDelete: Restrict, onUpdate: Cascade, map: "fk_user_department")
  managedDepartment   Department?           @relation("Manages")
  createdTypes        TransactionType[]
  createdTransactions Transaction[]
  uploadedDocuments   Document[]
  attachedDocuments   TransactionDocument[]
  sentForwards        TransactionForward[]  @relation("SentForwards")
  receivedForwards    TransactionForward[]  @relation("ReceivedForwards")
  budgetEntries       BudgetEntry[]
  notifications       Notification[]
}

model Document {
  id         Int      @id @default(autoincrement())
  title      String
  content    Bytes
  uploaderId Int
  uploadedAt DateTime @default(now()) @db.Timestamptz

  uploader     User                  @relation(fields: [uploaderId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_document_uploader")
  transactions TransactionDocument[]
}

enum TransactionPriority {
  HIGH
  MEDIUM
  LOW
}

model Transaction {
  id               Int                 @id @default(autoincrement())
  title            String
  description      String
  typeName         String
  fulfilled        Boolean             @default(false)
  priority         TransactionPriority @default(LOW)
  budgetName       String?
  budgetAllocation Float?
  creatorId        Int
  createdAt        DateTime            @default(now()) @db.Timestamptz

  type          TransactionType           @relation(fields: [typeName], references: [name], onDelete: Restrict, onUpdate: Cascade, map: "fk_transaction_type")
  creator       User                      @relation(fields: [creatorId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_transaction_creator")
  budget        BudgetCategory?           @relation(fields: [budgetName], references: [name], onDelete: Restrict, onUpdate: Cascade, map: "fk_transaction_budget")
  documents     TransactionDocument[]
  forwards      TransactionForward[]
  latestForward TransactionLatestForward?
}

// FIXME: This view is manually created in the migration since `view` is a prisma preview feature atm
view TransactionLatestForward {
  id            Int                      @unique
  status        TransactionForwardStatus
  senderId      Int
  receiverId    Int
  transactionId Int

  transaction Transaction @relation(fields: [transactionId], references: [id])

  // FIXME: ORDER BY "transactionId", "id" DESC (not available in prisma atm)
  @@unique([transactionId])
}

model TransactionDocument {
  transactionId Int
  documentId    Int
  attachedBy    Int
  attachedAt    DateTime @default(now()) @db.Timestamptz

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_transaction_document")
  document    Document    @relation(fields: [documentId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_document_transaction")
  attacher    User        @relation(fields: [attachedBy], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_transaction_document_attacher")

  @@id([transactionId, documentId], map: "pk_transaction_document")
}

model TransactionType {
  name      String @id
  creatorId Int

  creator      User          @relation(fields: [creatorId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_transaction_type_creator")
  transactions Transaction[]
}

enum TransactionForwardStatus {
  WAITING
  NEEDS_EDITING
  REJECTED
  APPROVED
}

model TransactionForward {
  id              Int                      @id @default(autoincrement())
  status          TransactionForwardStatus @default(WAITING)
  senderComment   String?
  receiverComment String?
  senderId        Int
  receiverId      Int
  senderSeen      Boolean                  @default(true)
  senderSeenAt    DateTime?                @db.Timestamptz
  receiverSeen    Boolean                  @default(false)
  receiverSeenAt  DateTime?                @db.Timestamptz
  forwardedAt     DateTime                 @default(now()) @db.Timestamptz
  updatedAt       DateTime                 @updatedAt @db.Timestamptz
  transactionId   Int

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_transaction_forward")
  sender      User        @relation("SentForwards", fields: [senderId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_transaction_forward_sender")
  receiver    User        @relation("ReceivedForwards", fields: [receiverId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_transaction_forward_receiver")
}

model BudgetCategory {
  name String @id
  preallocation Float @default(0)

  entries      BudgetEntry[]
  transactions Transaction[]
  details      BudgetCategoryDetails?
}

model BudgetEntry {
  id         Int      @id @default(autoincrement())
  inputterId Int
  amount     Float
  budgetName String
  createdAt  DateTime @default(now()) @db.Timestamptz

  inputter User           @relation(fields: [inputterId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_budget_entry_inputter")
  budget   BudgetCategory @relation(fields: [budgetName], references: [name], onDelete: Restrict, onUpdate: Cascade, map: "fk_budget_entry")
}

// FIXME: This view is manually created in the migration since `view` is a prisma preview feature atm
view BudgetCategoryDetails {
  budgetName    String @unique
  budget        Float
  allocated     Float
  available     Float
  preallocation Float

  category BudgetCategory @relation(fields: [budgetName], references: [name])
}

enum NotificationType {
  INFO
  WARNING
}

model Notification {
  id          Int              @id @default(autoincrement())
  userId      Int
  timestamp   DateTime         @default(now()) @db.Timestamptz
  seen        Boolean          @default(false)
  type        NotificationType @default(INFO)
  code        String
  args        Json?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_notification_user")
}
